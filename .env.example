# --- Base de données (Supabase) ---
# Connexion "pooled" via PgBouncer (port 6543) : utilisée par l'application au runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (port 5432) : utilisée uniquement par les migrations Prisma.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase Storage (photos de devis, plus tard) ---
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# --- Auth.js ---
# Générer avec: npx auth secret (ou `openssl rand -base64 32`)
AUTH_SECRET="[GENERATED-SECRET]"
NEXTAUTH_URL="http://localhost:3001"
