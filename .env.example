# --- Base de données (Supabase) ---
# Valeurs exactes disponibles dans le bouton "Connect" du dashboard Supabase
# (onglet ORMs > Prisma). Le format dépend de la région du projet.

# Connexion via le pooler en transaction-mode (port 6543) : utilisée par l'application au runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion via le pooler en session-mode (port 5432) : utilisée pour les migrations Prisma.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Storage (photos de devis, plus tard) ---
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# --- Resend (email de réinitialisation de mot de passe) ---
RESEND_API_KEY="[RESEND-API-KEY]"
# onboarding@resend.dev fonctionne sans domaine verifie (a remplacer par une
# adresse sur votre propre domaine une fois verifiee sur resend.com/domains)
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Auth.js ---
# Générer avec: npx auth secret (ou `openssl rand -base64 32`)
AUTH_SECRET="[GENERATED-SECRET]"
NEXTAUTH_URL="http://localhost:3001"
