// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum DevisStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum FactureStatus {
  BROUILLON
  EMISE
  PAYEE
  ANNULEE
}

enum InterventionStatus {
  PLANIFIEE
  CONFIRMEE
  TERMINEE
  ANNULEE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devis   Devis[]
  factures Facture[]
  resetTokens PasswordResetToken[]
}

// Jeton de réinitialisation de mot de passe. Seul le hash du jeton est
// stocké (jamais le jeton en clair, envoyé une seule fois par email) ;
// on le compare au hash du jeton reçu dans le lien de réinitialisation.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

// Fiche client centralisée : sert à retrouver l'historique (devis/factures)
// d'un client et à pré-remplir un nouveau devis. Les devis/factures gardent
// leur propre copie des coordonnées (voir Devis.clientNom etc.), donc modifier
// ou supprimer une fiche Client ne change jamais un document déjà émis.
model Client {
  id          String   @id @default(cuid())
  nom         String
  email       String?
  telephone   String?
  adresse     String?
  notes       String?

  devis         Devis[]
  interventions Intervention[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Un devis regroupe des prestations chiffrées envoyées à un client.
// Le devis reste modifiable tant qu'il n'a pas été transformé en facture.
model Devis {
  id          String      @id @default(cuid())
  numero      Int         @unique @default(autoincrement())
  status      DevisStatus @default(BROUILLON)

  // Copie figée des coordonnées au moment du devis (indépendante de la
  // fiche Client, qui peut évoluer par la suite) : c'est cette copie qui
  // fait foi sur le devis et, plus tard, sur la facture émise.
  clientNom     String
  clientEmail   String?
  clientTelephone String?
  clientAdresse String?

  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?

  lignes      LigneDevis[]
  totalHT     Decimal      @default(0) @db.Decimal(10, 2)
  totalTTC    Decimal      @default(0) @db.Decimal(10, 2)

  notes       String?
  envoyeAt    DateTime?
  repondtAt   DateTime?

  facture     Facture?
  interventions Intervention[]

  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LigneDevis {
  id          String  @id @default(cuid())
  devis       Devis   @relation(fields: [devisId], references: [id], onDelete: Cascade)
  devisId     String

  description String
  quantite    Decimal @db.Decimal(10, 2)
  prixUnitaireHT Decimal @db.Decimal(10, 2)
  tauxTVA     Decimal @default(20) @db.Decimal(4, 2)

  ordre       Int     @default(0)
}

// Une facture est émise à partir d'un devis accepté.
// Contrainte légale (France) : numérotation séquentielle sans trou et
// immuabilité une fois émise -> le champ `verrouillee` bloque toute
// modification des lignes/montants après émission ; seule une facture
// d'avoir (à modéliser plus tard) peut corriger une facture émise.
//
// `numero` reste NULL tant que la facture est en brouillon : le numéro
// légal n'est attribué qu'au moment de l'émission (voir FactureCounter),
// pas à la création, pour éviter tout trou dans la séquence si un brouillon
// est abandonné.
model Facture {
  id          String        @id @default(cuid())
  numero      Int?          @unique
  status      FactureStatus @default(BROUILLON)
  verrouillee Boolean       @default(false)

  devis       Devis   @relation(fields: [devisId], references: [id])
  devisId     String  @unique

  clientNom     String
  clientEmail   String?
  clientAdresse String?

  // Mentions légales à figer au moment de l'émission (pré-remplies depuis
  // Paramètres, voir entreprise.service.ts).
  mentionsLegales String?

  lignes      LigneFacture[]
  totalHT     Decimal @default(0) @db.Decimal(10, 2)
  totalTTC    Decimal @default(0) @db.Decimal(10, 2)

  emiseAt     DateTime?
  // Fixée à l'émission (aujourd'hui + délai de paiement configuré dans
  // Paramètres), pour savoir quand une facture émise devient en retard.
  dateEcheance DateTime?
  payeeAt     DateTime?
  derniereRelanceAt DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LigneFacture {
  id          String  @id @default(cuid())
  facture     Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId   String

  description String
  quantite    Decimal @db.Decimal(10, 2)
  prixUnitaireHT Decimal @db.Decimal(10, 2)
  tauxTVA     Decimal @default(20) @db.Decimal(4, 2)

  ordre       Int     @default(0)
}

// Ligne unique (id fixe = 1) servant de compteur transactionnel pour la
// numérotation légale des factures. Le service d'émission doit verrouiller
// cette ligne (SELECT ... FOR UPDATE via une transaction Prisma), incrémenter
// `dernierNumero`, puis assigner la nouvelle valeur à Facture.numero dans la
// même transaction, pour garantir une séquence strictement croissante sans trou.
model FactureCounter {
  id            Int @id @default(1)
  dernierNumero Int @default(0)
}

// Créneau de planning lié à un devis (avant facturation) ou existant seul
// (rendez-vous non encore chiffré).
model Intervention {
  id          String              @id @default(cuid())
  titre       String
  status      InterventionStatus  @default(PLANIFIEE)

  debut       DateTime
  fin         DateTime

  devis       Devis?  @relation(fields: [devisId], references: [id])
  devisId     String?

  // Optionnel : un rendez-vous peut concerner un client sans devis associé
  // (ex: visite de courtoisie, dépannage à chiffrer sur place).
  client      Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?

  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Ligne unique (id fixe = 1) : coordonnées de l'entreprise, saisies une
// fois par l'utilisateur dans Paramètres. Sert à pré-remplir les mentions
// légales obligatoires au moment de l'émission d'une facture (voir
// facture.service.ts), plutôt que de les retaper à chaque fois.
model EntrepriseSettings {
  id              Int      @id @default(1)
  nom             String   @default("Houel Plombier")
  statutJuridique String?
  siret           String?
  numeroTVA       String?
  adresse         String?
  telephone       String?
  email           String?
  iban            String?
  mentionsComplementaires String?
  delaiPaiementJours Int   @default(30)

  updatedAt       DateTime @updatedAt
}
